{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 ferramentas/tempo.py:*)",
      "Bash(python3 ferramentas/pagina.py:*)",
      "Bash(python ferramentas/tempo.py:*)",
      "Bash(python ferramentas/pagina.py:*)",
      "Bash(py ferramentas/tempo.py:*)",
      "Bash(py ferramentas/pagina.py:*)",
      "Bash(open saida/:*)",
      "Bash(xdg-open saida/:*)",
      "Edit(./saida/**)",
      "Write(./saida/**)",
      "Read(./**)",
      "WebSearch",
      "WebFetch",
      "Agent(planeador)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/diario.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
